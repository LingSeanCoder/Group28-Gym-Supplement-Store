# Cấu hình backend
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Điền mật khẩu PostgreSQL trong .env trên máy, không commit giá trị thật.
# Khi dùng Supabase, điền DATABASE_URL và đổi DATABASE_SSL=true.
# DATABASE_URL được ưu tiên hơn các biến PG* bên dưới.
DATABASE_URL=
DATABASE_SSL=false
# Tùy chọn: chứng chỉ CA chính thức, đường dẫn tương đối từ backend/.
DATABASE_SSL_CA_PATH=
PGHOST=localhost
PGPORT=5432
PGDATABASE=gym_supplement_store
PGUSER=postgres
PGPASSWORD=
