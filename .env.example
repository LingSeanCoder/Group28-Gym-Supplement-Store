# Database: use DATABASE_URL OR the local PG* settings below.
DATABASE_URL=
# Local: false. Supabase: true. Không thêm sslmode vào DATABASE_URL.
DATABASE_SSL=false
# Tùy chọn: đường dẫn CA chính thức, tương đối từ backend/ hoặc đường dẫn tuyệt đối.
DATABASE_SSL_CA_PATH=
PGHOST=localhost
PGPORT=5432
PGDATABASE=gym_supplement_store
PGUSER=postgres
PGPASSWORD=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=

# Server
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:5000/api
